<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fixes "site doesn't show the latest deploy in a normal browser tab until cache is cleared,
  but Incognito always shows it" - Incognito never caches, so it always fetches fresh files;
  a normal tab caches everything, including index.html, so it can keep loading an old build.

  Angular's production build content-hashes every JS/CSS filename (main-XXXX.js), so those files
  are safe to cache for a long time - any code change produces a brand new filename. index.html
  is the one file that is NOT hashed and always has to be fetched fresh, since it's what points
  the browser at the current hashed filenames. This file long-caches everything by default, then
  explicitly forces index.html to never be cached, so every visit immediately gets the latest
  deployed version without anyone needing to manually clear their cache.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <!--
      Angular is a single-page app - only index.html is a real file on disk; every route like
      /daily-site/5 or /vehicle-service-repair/5/print only exists client-side, resolved by
      Angular's own router after index.html's JS has loaded. Landing directly on one of those
      URLs (a bookmark, a refresh, a print button opening a new tab) makes IIS look for an actual
      file/folder at that path and 404 before Angular ever gets a chance to run. This rule sends
      any request that isn't a real file or folder to index.html instead, letting the Angular
      router take over from there - same fallback the local dev server already does automatically.
      Requires the IIS URL Rewrite module - if this causes a 500.19 "cannot read configuration
      file" error instead of fixing the 404, that module isn't installed on the server yet.
    -->
    <rewrite>
      <rules>
        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- The API is deployed as its own nested IIS Application at /api under this same
                 site - without this exclusion, this catch-all fallback intercepts every request
                 to it too (rewriting them to index.html) before the API app ever sees them. -->
            <add input="{URL}" pattern="^/api/" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
          <add name="Pragma" value="no-cache" />
          <add name="Expires" value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!--
    Same reasoning as the index.html rule above, applied to the face recognition model files
    (assets/face-models/*). Unlike main-XXXX.js, these are plain Angular "assets" - copied as-is
    with their original filenames, never content-hashed - so a future update to them would keep
    the exact same URL. Under the default 365-day cache above, anyone who already loaded the page
    once would keep silently using their old cached copy (mismatched against a newer manifest.json
    or shard file) until they manually cleared their cache, causing confusing errors like a
    "tensor shape mismatch". Forcing these to always revalidate means updates take effect
    immediately for everyone, live or local, with no manual cache clearing ever needed.
  -->
  <location path="assets/face-models">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
          <add name="Pragma" value="no-cache" />
          <add name="Expires" value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
